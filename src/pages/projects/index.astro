---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

// Берем ТОЛЬКО публичные проекты (где private не true)
const projects = (await getCollection('projects')).filter(p => !p.data.private);
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Мои проекты</title>
	</head>
	<body class="bg-zinc-950 text-zinc-50 min-h-screen font-sans selection:bg-purple-500 selection:text-white flex flex-col">
		
		<header class="max-w-4xl mx-auto pt-20 pb-12 px-6 w-full">
			<a href="/" class="text-sm text-zinc-500 hover:text-purple-400 mb-6 inline-block transition-colors">
				&larr; На главную
			</a>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Публичные проекты</h1>
			<p class="text-zinc-400 text-lg">Мои открытые работы и разработки.</p>
		</header>

		<main class="max-w-4xl mx-auto px-6 pb-12 w-full flex-grow">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{projects.map((project) => (
					<a href={`/projects/${project.id}`} class="group flex flex-col p-6 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-purple-500/50 hover:bg-zinc-800/50 transition-all duration-300">
						<h2 class="text-2xl font-semibold mb-2 group-hover:text-purple-400 transition-colors">
							{project.data.title}
						</h2>
						<p class="text-zinc-400 mb-4 flex-grow">{project.data.description}</p>
						{project.data.tags && (
							<div class="flex flex-wrap gap-2 mt-auto">
								{project.data.tags.map(tag => (
									<span class="text-xs px-2 py-1 rounded-md bg-zinc-800 text-zinc-300 border border-zinc-700">{tag}</span>
								))}
							</div>
						)}
					</a>
				))}
			</div>
		</main>

		<div class="max-w-4xl mx-auto px-6 pb-24 w-full">
			<a href="/secret" class="inline-block bg-zinc-900 hover:bg-zinc-800 border border-red-500/30 hover:border-red-500/80 text-red-400 font-medium py-3 px-8 rounded-lg transition-all duration-300">
				🔒 Закрытые проекты
			</a>
		</div>

		<footer class="border-t border-zinc-800 py-8 text-center text-zinc-500 text-sm w-full">
			<p>&copy; 2026 Мое Портфолио. Сделано на Astro.</p>
		</footer>

	</body>
</html>