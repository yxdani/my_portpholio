---
import { getCollection, render } from 'astro:content';
import '../../styles/global.css';

export async function getStaticPaths() {
const projects = await getCollection('projects');
return projects.map(project => ({
params: { id: project.id },
props: { project },
}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<title>{project.data.title}</title>
</head>
<body class="bg-zinc-950 text-zinc-50 min-h-screen font-sans selection:bg-purple-500 selection:text-white">

<main class="max-w-3xl mx-auto pt-20 pb-24 px-6">
<a href="/projects" class="text-sm text-zinc-500 hover:text-purple-400 mb-8 inline-block transition-colors">
&larr; Назад ко всем проектам
</a>

<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">{project.data.title}</h1>
<p class="text-xl text-zinc-400 mb-8">{project.data.description}</p>

<article class="prose prose-invert prose-purple max-w-none">
<Content />
</article>
</main>

</body>
</html>