---
import { getCollection } from 'astro:content';
import '../styles/global.css';

// Берем ТОЛЬКО закрытые проекты
const projects = (await getCollection('projects')).filter(p => p.data.private);
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Закрытые проекты</title>
	</head>
	<body class="bg-zinc-950 text-zinc-50 min-h-screen font-sans selection:bg-purple-500 selection:text-white flex flex-col">
		
		<!-- Скрипт для защиты страницы (если нет пароля — кидаем на ввод) -->
		<script is:inline>
			if (sessionStorage.getItem('secret_access') !== 'true') {
				window.location.href = '/secret';
			}
		</script>

		<header class="max-w-4xl mx-auto pt-20 pb-12 px-6 w-full">
			<a href="/projects" class="text-sm text-zinc-500 hover:text-purple-400 mb-6 inline-block transition-colors">
				&larr; К публичным проектам
			</a>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-red-400">Закрытые проекты</h1>
			<p class="text-zinc-400 text-lg">Доступ разрешен. Только для избранных.</p>
		</header>

		<main class="max-w-4xl mx-auto px-6 pb-24 w-full flex-grow">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{projects.map((project) => (
					<a href={`/projects/${project.id}`} class="group flex flex-col p-6 rounded-2xl bg-zinc-900 border border-red-900/50 hover:border-red-500/80 hover:bg-zinc-800/50 transition-all duration-300">
						<h2 class="text-2xl font-semibold mb-2 group-hover:text-red-400 transition-colors">
							{project.data.title}
						</h2>
						<p class="text-zinc-400 mb-4 flex-grow">{project.data.description}</p>
						{project.data.tags && (
							<div class="flex flex-wrap gap-2 mt-auto">
								{project.data.tags.map(tag => (
									<span class="text-xs px-2 py-1 rounded-md bg-zinc-800 text-zinc-300 border border-zinc-700">{tag}</span>
								))}
							</div>
						)}
					</a>
				))}
			</div>
		</main>

		<footer class="border-t border-zinc-800 py-8 text-center text-zinc-500 text-sm w-full">
			<p>&copy; 2026 Мое Портфолио. Сделано на Astro.</p>
		</footer>

	</body>
</html>