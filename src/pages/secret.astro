---
import '../styles/global.css';
---

<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<title>Закрытые проекты</title>
</head>
<body class="bg-zinc-950 text-zinc-50 min-h-screen font-sans selection:bg-purple-500 selection:text-white flex flex-col items-center justify-center">

<div class="w-full max-w-md p-8 bg-zinc-900 rounded-2xl border border-zinc-800 shadow-2xl">
<h1 class="text-3xl font-bold mb-2 text-center text-red-400">🔒 Доступ закрыт</h1>
<p class="text-zinc-400 text-center mb-8">Введите пароль, чтобы увидеть закрытые проекты.</p>

<div class="space-y-4">
<input 
type="password" 
id="password-input" 
placeholder="Пароль" 
class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-red-500 transition-colors"
>
<button 
id="submit-btn" 
class="w-full bg-red-600 hover:bg-red-500 text-white font-medium py-3 rounded-lg transition-colors"
>
Войти
</button>
</div>

<p id="error-msg" class="text-red-500 text-center mt-4 hidden">Неверный пароль!</p>
</div>

<script is:inline>
const CORRECT_PASSWORD = "123";

const input = document.getElementById('password-input');
const btn = document.getElementById('submit-btn');
const errorMsg = document.getElementById('error-msg');

function checkPassword() {
if (input.value === CORRECT_PASSWORD) {
sessionStorage.setItem('secret_access', 'true');
window.location.href = '/secret-projects';
} else {
errorMsg.classList.remove('hidden');
input.value = '';
}
}

btn.addEventListener('click', checkPassword);
input.addEventListener('keypress', (e) => {
if (e.key === 'Enter') checkPassword();
});
</script>

</body>
</html>