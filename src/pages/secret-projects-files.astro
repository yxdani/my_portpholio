---
import '../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';

const filesDir = path.join(process.cwd(), 'public', 'secret-projects-files');
let files: { name: string; size: number }[] = [];
try {
  files = fs.readdirSync(filesDir)
    .filter(f => !f.startsWith('.'))
    .map(f => {
      const stat = fs.statSync(path.join(filesDir, f));
      return { name: f, size: stat.size };
    });
} catch {
  files = [];
}

function formatSize(bytes: number) {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}
---

<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<title>Файлы закрытых проектов</title>
</head>
<body class="bg-zinc-950 text-zinc-50 min-h-screen font-sans selection:bg-purple-500 selection:text-white flex flex-col">

<script is:inline>
if (sessionStorage.getItem('secret_access') !== 'true') {
window.location.href = '/secret';
}
</script>

<header class="max-w-4xl mx-auto pt-20 pb-12 px-6 w-full">
<a href="/secret-projects" class="text-sm text-zinc-500 hover:text-red-400 mb-6 inline-block transition-colors">
&larr; К закрытым проектам
</a>
<h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-red-400">Файлы закрытых проектов</h1>
<p class="text-zinc-400 text-lg">Доступ разрешен. Эти файлы скрыты от посторонних.</p>
</header>

<main class="max-w-4xl mx-auto px-6 pb-24 w-full flex-grow">
<div>
{files.length === 0 ? (
<p class="text-zinc-500">Пока файлов нет. Положите их в папку <code class="text-red-400">public/secret-projects-files/</code>.</p>
) : (
<div class="grid grid-cols-1 gap-4">
{files.map(file => (
<a href={`/secret-projects-files/${file.name}`} download class="group flex items-center justify-between p-5 rounded-xl bg-zinc-900 border border-red-900/50 hover:border-red-500/80 hover:bg-zinc-800/50 transition-all duration-300">
<div class="min-w-0 pr-4">
<p class="font-medium truncate text-red-400">{file.name}</p>
<p class="text-xs text-zinc-500 mt-1">{formatSize(file.size)}</p>
</div>
<span class="text-red-400 text-sm font-medium group-hover:underline flex-shrink-0">Скачать ↓</span>
</a>
))}
</div>
)}
</div>
</main>

<footer class="border-t border-zinc-800 py-8 text-center text-zinc-500 text-sm w-full">
<p>&copy; 2026 Мое Портфолио. Сделано на Astro.</p>
</footer>

</body>
</html>